<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adicionar Relato - GasGuard IA</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f7f7f7;
            margin: 0;
            padding: 20px;
        }

        h2 {
            text-align: center;
        }

        .container {
            max-width: 400px;
            margin: auto;
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        label {
            font-weight: bold;
            margin-top: 10px;
            display: block;
        }

        select, input, textarea, button {
            width: 100%;
            padding: 12px;
            margin-top: 6px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 14px;
        }

        button {
            background: #0077ff;
            color: white;
            border: none;
            margin-top: 20px;
            cursor: pointer;
        }

        button:hover {
            background: #005fd1;
        }
    </style>
</head>

<body>

    <h2>Adicionar Relato</h2>

    <div class="container">

        <label>Tipo de combustível</label>
        <select>
            <option>Gasolina comum</option>
            <option>Gasolina aditivada</option>
            <option>Etanol</option>
            <option>Diesel</option>
            <option>GNV</option>
        </select>

        <label>Data do abastecimento</label>
        <input type="date">

        <label>Problema ocorrido</label>
        <textarea rows="4" placeholder="Descreva o que aconteceu..."></textarea>

        <label>Km atual</label>
        <input type="number" placeholder="Ex: 125000">

        <label>Valor abastecido (R$)</label>
        <input type="number" step="0.01" placeholder="Ex: 120.00">

        <label>Nota do posto</label>
        <select>
            <option>⭐ 1</option>
            <option>⭐ 2</option>
            <option>⭐ 3</option>
            <option>⭐ 4</option>
            <option>⭐ 5</option>
        </select>

        <button>Enviar Relato</button>
    </div>

</body>
</html>
