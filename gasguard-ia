<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>GasGuard IA</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #0A1A2F; /* azul escuro */
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            text-align: center;
        }

        .container {
            width: 90%;
            max-width: 400px;
        }

        .logo {
            font-size: 32px;
            font-weight: bold;
            margin-bottom: 30px;
        }

        .btn {
            width: 100%;
            padding: 15px;
            margin: 10px 0;
            border: none;
            border-radius: 8px;
            font-size: 18px;
            cursor: pointer;
        }

        .google {
            background: #ffffff;
            color: #000;
        }

        .convidado {
            background: #1E90FF; /* azul */
            color: white;
        }

        .btn:hover {
            opacity: 0.85;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="logo">
            GASGUARD IA
        </div>

        <button class="btn google">Entrar com Google</button>

        <button class="btn convidado">Entrar como convidado</button>
    </div>
</body>
</html>
